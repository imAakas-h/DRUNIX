{
  "name": "rasid",
  "version": "0.1.0",
  "description": "Rasid: post-discount factoring position ledger on Drunix (Hyperledger Fabric v2.5 model)",
  "private": true,
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start-dev.js",
    "start:demo": "node --env-file-if-exists=.env scripts/start-dev.js",
    "dev": "node --env-file-if-exists=.env scripts/start-dev.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test test/*.test.js",
    "test:chaincode": "cd chaincode/rasid && go test ./rules",
    "verify:concurrency": "node --env-file-if-exists=.env scripts/verify-concurrency.js",
    "benchmark": "node --env-file-if-exists=.env scripts/benchmark.js",
    "test:drunix": "node --env-file-if-exists=.env scripts/test-drunix.js",
    "build:web": "npm --prefix web run build",
    "test:e2e": "cd web && npx playwright test"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@hyperledger/fabric-gateway": "^1.5.0",
    "express": "^4.22.3",
    "zod": "^3.25.76"
  }
}