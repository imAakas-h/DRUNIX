# The local demo launcher forces simulation mode and uses DATA_DIR=./data/demo.
# No real Fabric network is contacted by the demo.
LEDGER_MODE=simulation
LEDGER_ALLOWED_MODES=simulation
PORT=3000
SIMULATION_DATA_DIR=./data/demo

# Mandatory for authenticated sessions. Use a random secret of at least 32 characters.
SESSION_SECRET=
# Used only when LEDGER_MODE=dev outside production.
RASID_DEMO_PASSWORD=rasid-demo
# In Drunix mode (and always in production), set a distinct strong password for each identity.
RASID_PASSWORD_OPERATOR=
RASID_PASSWORD_FINANCIER_A=
RASID_PASSWORD_FINANCIER_B=
RASID_PASSWORD_FINANCIER_C=
RASID_PASSWORD_FINANCIER_D=
RASID_PASSWORD_INSURER=
RASID_PASSWORD_AUDITOR=

# Drunix network values must be supplied by the network operator.
DRUNIX_NETWORK_NAME=
CHANNEL=mychannel
CHAINCODE=rasid
IDENTITIES_FILE=./identities.json

# The identity template resolves these environment variables at runtime.
# Supply paths to issued credentials and the actual Drunix client-facing peer endpoint.
DRUNIX_OPERATOR_MSP_ID=
DRUNIX_OPERATOR_CERT_PATH=
DRUNIX_OPERATOR_KEY_PATH=
DRUNIX_OPERATOR_PEER_ENDPOINT=
DRUNIX_OPERATOR_HOST_ALIAS=
DRUNIX_OPERATOR_TLS_CERT_PATH=

DRUNIX_FINANCIER_A_MSP_ID=
DRUNIX_FINANCIER_A_CERT_PATH=
DRUNIX_FINANCIER_A_KEY_PATH=
DRUNIX_FINANCIER_A_PEER_ENDPOINT=
DRUNIX_FINANCIER_A_HOST_ALIAS=
DRUNIX_FINANCIER_A_TLS_CERT_PATH=

DRUNIX_FINANCIER_B_MSP_ID=
DRUNIX_FINANCIER_B_CERT_PATH=
DRUNIX_FINANCIER_B_KEY_PATH=
DRUNIX_FINANCIER_B_PEER_ENDPOINT=
DRUNIX_FINANCIER_B_HOST_ALIAS=
DRUNIX_FINANCIER_B_TLS_CERT_PATH=

DRUNIX_FINANCIER_C_MSP_ID=
DRUNIX_FINANCIER_C_CERT_PATH=
DRUNIX_FINANCIER_C_KEY_PATH=
DRUNIX_FINANCIER_C_PEER_ENDPOINT=
DRUNIX_FINANCIER_C_HOST_ALIAS=
DRUNIX_FINANCIER_C_TLS_CERT_PATH=

DRUNIX_FINANCIER_D_MSP_ID=
DRUNIX_FINANCIER_D_CERT_PATH=
DRUNIX_FINANCIER_D_KEY_PATH=
DRUNIX_FINANCIER_D_PEER_ENDPOINT=
DRUNIX_FINANCIER_D_HOST_ALIAS=
DRUNIX_FINANCIER_D_TLS_CERT_PATH=

DRUNIX_INSURER_MSP_ID=
DRUNIX_INSURER_CERT_PATH=
DRUNIX_INSURER_KEY_PATH=
DRUNIX_INSURER_PEER_ENDPOINT=
DRUNIX_INSURER_HOST_ALIAS=
DRUNIX_INSURER_TLS_CERT_PATH=

DRUNIX_AUDITOR_MSP_ID=
DRUNIX_AUDITOR_CERT_PATH=
DRUNIX_AUDITOR_KEY_PATH=
DRUNIX_AUDITOR_PEER_ENDPOINT=
DRUNIX_AUDITOR_HOST_ALIAS=
DRUNIX_AUDITOR_TLS_CERT_PATH=
